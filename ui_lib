function WindowMethods:SelectPage(name)
    for _, closer in pairs(Library.OpenFrames) do pcall(closer) end
    Library.OpenFrames = {}
    self.CurrentPage = name
    for pageName, page in pairs(self.Pages) do
        local active = pageName == name
        if active then
            if not page.Page.Visible then
                page.Page.Visible = true
                page.Page.Position = UDim2.fromOffset(10, 0)
                page.Page.GroupTransparency = 1
            end
            if page.PageScale then page.PageScale.Scale = 0.985 end
            tween(page.Page, {GroupTransparency = 0, Position = UDim2.fromOffset(0, 0)}, 0.2)
            if page.PageScale then tween(page.PageScale, {Scale = 1}, 0.2) end
        else
            page.Page.Visible = false
            page.Page.GroupTransparency = 1
        end
    end
    for tabName, tab in pairs(self.Tabs) do
        tween(tab, {TextColor3 = tabName == name and Library.Theme.Accent or Library.Theme.Dim, BackgroundTransparency = 1}, 0.2)
    end
    task.defer(function()
        local tab = self.Tabs[name]
        if tab and tab.AbsoluteSize.X > 0 then
            self.Underline.BackgroundTransparency = 0
            self.UnderlineBloom.Transparency = 0.48
            tween(self.UnderlineBloom, {Transparency = 1}, 0.34)
            local sc = self.MainScale and math.max(self.MainScale.Scale, 0.001) or 1
            tween(self.Underline, {Position = UDim2.fromOffset((tab.AbsolutePosition.X - self.Main.AbsolutePosition.X) / sc, 33), Size = UDim2.fromOffset(tab.AbsoluteSize.X / sc, 2)}, 0.25)
        end
    end)
end

