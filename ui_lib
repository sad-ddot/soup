    local gradient = new("UIGradient", {Rotation = 90, Color = value and ColorSequence.new(Color3.fromRGB(112, 151, 235)) or ColorSequence.new(Color3.fromRGB(12, 13, 15), Color3.fromRGB(23, 25, 30))}, box)
    local scale = new("UIScale", {Scale = 1}, box)
    local glow = new("Frame", {Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = box.ZIndex - 1}, box)
    round(glow, 3)
    local glowStrokes = {}
    for i = 1, 3 do
        glowStrokes[i] = new("UIStroke", {Color = Library.Theme.Accent, Thickness = i * 2, Transparency = 1}, glow)
    end
    local label = new("TextLabel", {Size = UDim2.new(1, -64, 1, 0), Position = UDim2.fromOffset(20, 0), BackgroundTransparency = 1, Text = name, TextColor3 = value and Library.Theme.Text or Library.Theme.Dim, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left}, row)
    local control = {Instance = row}
    local function apply(newValue, silent)
        value = newValue == true
        Library.Flags[flag] = value
        gradient.Color = value and ColorSequence.new(Color3.fromRGB(112, 151, 235)) or ColorSequence.new(Color3.fromRGB(12, 13, 15), Color3.fromRGB(23, 25, 30))
        boxStroke.Color = value and Library.Theme.Accent or Library.Theme.Stroke
        tween(label, {TextColor3 = value and Library.Theme.Text or Library.Theme.Dim}, 0.14)
        for i, gs in ipairs(glowStrokes) do tween(gs, {Transparency = value and (0.6 + i * 0.1) or 1}, 0.14) end
        if value then scale.Scale = 0.82 tween(scale, {Scale = 1}, 0.2) end
        if not silent then Library:SafeCall(callback, value) end
    end
    connect(row.MouseButton1Click, function() apply(not value) end)
    function control:Set(newValue) apply(newValue, true) end
    function control:Get() return value end
    Library.Flags[flag] = value
    return control
end

