function WindowMethods:KeybindList()
    local frame = new("CanvasGroup", {Size = UDim2.fromOffset(190, 48), Position = UDim2.new(0.5, -95, 0, 58), BackgroundColor3 = Library.Theme.Bg, BorderSizePixel = 0, Visible = true, GroupTransparency = 0}, self.Gui)
