function Library:CreateColorpicker(data)
    data = data or {}
    local state = {Color = data.Default or Color3.new(1, 1, 1), Transparency = data.Alpha or 0}
    local flag = data.Flag
    self.Flags[flag] = state
    local swatch = new("TextButton", {Size = UDim2.fromOffset(30, 14), Position = UDim2.new(1, -34, 0.5, -7), BackgroundColor3 = state.Color, BorderSizePixel = 0, Text = "", AutoButtonColor = false, ZIndex = 6, Name = "__swatch"}, data.Parent)
    round(swatch, 4)
    stroke(swatch, Library.Theme.Stroke, 0.05)
    local popup = new("CanvasGroup", {Parent = data.Window.PopupLayer, Size = UDim2.fromOffset(180, 126), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Visible = false, GroupTransparency = 1, ZIndex = 9200})
    round(popup, 6)
    stroke(popup, Library.Theme.Stroke, 0.05)
    new("UIGradient", {Parent = popup, Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(12, 13, 15), Color3.fromRGB(23, 25, 30))})
    local title = new("TextLabel", {Parent = popup, Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 6), BackgroundTransparency = 1, Text = data.Name or "Color", TextColor3 = Library.Theme.Text, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9201})
    local colors = {Color3.fromRGB(255,255,255), Library.Theme.Accent, Library.Theme.Accent2, Color3.fromRGB(255,80,80), Color3.fromRGB(80,255,120), Color3.fromRGB(255,220,70), Color3.fromRGB(180,120,255), Color3.fromRGB(0,0,0)}
    local grid = new("Frame", {Parent = popup, Size = UDim2.fromOffset(164, 44), Position = UDim2.fromOffset(8, 28), BackgroundTransparency = 1, ZIndex = 9201})
    new("UIGridLayout", {Parent = grid, CellSize = UDim2.fromOffset(35, 18), CellPadding = UDim2.fromOffset(8, 6), SortOrder = Enum.SortOrder.LayoutOrder})
    local alpha = new("TextButton", {Parent = popup, Size = UDim2.fromOffset(164, 22), Position = UDim2.fromOffset(8, 80), BackgroundColor3 = Library.Theme.Input, BorderSizePixel = 0, Text = "Alpha: " .. tostring(math.floor(state.Transparency * 100)) .. "%", TextColor3 = Library.Theme.Dim, TextSize = 11, AutoButtonColor = false, ZIndex = 9201})
    round(alpha, 3)
    stroke(alpha, Library.Theme.Stroke, 0.15)
    local open = false
    local function apply(color, transparency)
        if color then state.Color = color end
        if transparency ~= nil then state.Transparency = transparency end
        swatch.BackgroundColor3 = state.Color
        alpha.Text = "Alpha: " .. tostring(math.floor(state.Transparency * 100)) .. "%"
        Library.Flags[flag] = state
        Library:SafeCall(data.Callback, state.Color, state.Transparency)
    end
    for _, color in ipairs(colors) do
        local button = new("TextButton", {Parent = grid, BackgroundColor3 = color, BorderSizePixel = 0, Text = "", AutoButtonColor = false, ZIndex = 9202})
        round(button, 3)
        stroke(button, Library.Theme.Stroke, 0.15)
        connect(button.MouseButton1Click, function() apply(color) end)
    end
    connect(alpha.MouseButton1Click, function()
        local values = {0, 0.25, 0.5, 0.75}
        local index = 1
        for i, value in ipairs(values) do if math.abs(state.Transparency - value) < 0.01 then index = i + 1 end end
        if index > #values then index = 1 end
        apply(nil, values[index])
    end)
    local function place()
        popup.Position = UDim2.fromOffset(swatch.AbsolutePosition.X - data.Window.PopupLayer.AbsolutePosition.X, swatch.AbsolutePosition.Y - data.Window.PopupLayer.AbsolutePosition.Y + swatch.AbsoluteSize.Y + 4)
    end
    local function close()
        open = false
        Library.OpenFrames[popup] = nil
        tween(popup, {GroupTransparency = 1}, 0.12).Completed:Connect(function() if not open then popup.Visible = false end end)
    end
    local function show()
        for _, closer in pairs(Library.OpenFrames) do pcall(closer) end
        Library.OpenFrames = {}
        open = true
        place()
        popup.Visible = true
        popup.GroupTransparency = 1
        tween(popup, {GroupTransparency = 0}, 0.14)
        Library.OpenFrames[popup] = close
    end
    connect(swatch.MouseButton1Click, function() if open then close() else show() end end)
    connect(RunService.RenderStepped, function() if open and popup.Visible then place() end end)
    connect(UIS.InputBegan, function(input)
        if not open or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        task.defer(function()
            if open and not inBounds(input.Position, popup) and not inBounds(input.Position, swatch) then close() end
        end)
    end)
    self.SetFlags[flag] = function(value)
        if type(value) == "table" then
            if typeof(value.Color) == "Color3" then state.Color = value.Color end
            if value.Transparency ~= nil then state.Transparency = value.Transparency end
            if value.r then state.Color = Color3.new(value.r, value.g, value.b) state.Transparency = value.tr or 0 end
        elseif typeof(value) == "Color3" then
            state.Color = value
        end
        apply(state.Color, state.Transparency)
    end
    return {Set = self.SetFlags[flag], Get = function() return state end, Instance = swatch}
end

function Library:CreateKeybind(data)
    local flag = data.Flag
    local defaultKey = keyFromString(data.Default) or nil
    local bind = {Mode = data.Mode or "Toggle", Key = defaultKey, Toggled = false, active = false, Value = defaultKey and keyName(defaultKey) or "None"}
    self.Flags[flag] = bind
    local hasSwatch = data.Parent:FindFirstChild("__swatch") ~= nil
    local shell = new("Frame", {Size = UDim2.fromOffset(44, 14), Position = UDim2.new(1, hasSwatch and -84 or -50, 0.5, -7), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 5}, data.Parent)
    round(shell, 2)
    stroke(shell, Library.Theme.Stroke, 0.1)
    new("UIGradient", {Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(13, 14, 16), Color3.fromRGB(26, 28, 33))}, shell)
    local button = new("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Text = bind.Value, TextColor3 = Color3.fromRGB(245, 245, 245), TextSize = 9, AutoButtonColor = false, ZIndex = 6}, shell)
    local popup = new("CanvasGroup", {Size = UDim2.fromOffset(88, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Visible = false, GroupTransparency = 1, ZIndex = 9100}, data.Window.PopupLayer)
    round(popup, 5)
    stroke(popup, Library.Theme.Stroke, 0.05)
    new("UIGradient", {Parent = popup, Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(12, 13, 15), Color3.fromRGB(23, 25, 30))})
    new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, popup)
    new("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4)}, popup)
    local open = false
    local capture = false
    local modeButtons = {}
    local function updateFlag()
        bind.Value = bind.Key and keyName(bind.Key) or "None"
        button.Text = bind.Value
        bind.active = bind.Toggled
        Library.Flags[flag] = bind
        Library:SafeCall(data.Callback, bind.Toggled)
        if Library.KeyListRefresh then Library.KeyListRefresh() end
    end
    local function setMode(mode)
        bind.Mode = mode
        bind.Toggled = mode == "Always"
        bind.active = bind.Toggled
        for modeName, btn in pairs(modeButtons) do btn.TextColor3 = modeName == mode and Library.Theme.Accent or Library.Theme.Dim end
        updateFlag()
    end
    local function closePopup()
        open = false
        Library.OpenFrames[popup] = nil
        tween(popup, {Size = UDim2.fromOffset(88, 0), GroupTransparency = 1}, 0.12).Completed:Connect(function() if not open then popup.Visible = false end end)
    end
    local function placePopup()
        popup.Position = UDim2.fromOffset(shell.AbsolutePosition.X - data.Window.PopupLayer.AbsolutePosition.X, shell.AbsolutePosition.Y - data.Window.PopupLayer.AbsolutePosition.Y + shell.AbsoluteSize.Y + 3)
    end
    local function openPopup()
        for _, closer in pairs(Library.OpenFrames) do pcall(closer) end
        Library.OpenFrames = {}
        open = true
        placePopup()
        popup.Visible = true
        tween(popup, {Size = UDim2.fromOffset(88, 74), GroupTransparency = 0}, 0.14)
        Library.OpenFrames[popup] = closePopup
    end
    connect(RunService.RenderStepped, function()
        if open and popup.Visible then placePopup() end
    end)
    for _, mode in ipairs({"Hold", "Toggle", "Always"}) do
        local option = new("TextButton", {Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = mode, TextColor3 = mode == bind.Mode and Library.Theme.Accent or Library.Theme.Dim, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, ZIndex = 9101}, popup)
        new("UIPadding", {PaddingLeft = UDim.new(0, 8)}, option)
        modeButtons[mode] = option
        connect(option.MouseButton1Click, function() setMode(mode) closePopup() end)
    end
    connect(button.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then if open then closePopup() else openPopup() end end
    end)
    connect(button.MouseButton1Click, function()
        closePopup()
        capture = true
        button.Text = "..."
    end)
    connect(UIS.InputBegan, function(input, processed)
        if capture then
            if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                bind.Key = nil
            elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                bind.Key = input.KeyCode
            elseif input.UserInputType ~= Enum.UserInputType.None then
                bind.Key = input.UserInputType
            end
            capture = false
            updateFlag()
            return
        end
        if processed then return end
        if not bind.Key then return end
        if input.KeyCode == bind.Key or input.UserInputType == bind.Key then
            if bind.Mode == "Toggle" then bind.Toggled = not bind.Toggled elseif bind.Mode == "Hold" then bind.Toggled = true elseif bind.Mode == "Always" then bind.Toggled = true end
            updateFlag()
        end
    end)
    connect(UIS.InputEnded, function(input)
        if not bind.Key then return end
        if input.KeyCode == bind.Key or input.UserInputType == bind.Key then
            if bind.Mode == "Hold" then bind.Toggled = false updateFlag() end
        end
    end)
    local object = {}
    function object:Get() return bind.Mode, bind.Key, bind.Toggled end
    function object:GetState() return bind.Toggled end
    function object:Set(value)
        if type(value) == "table" then
            bind.Key = keyFromString(value.Key)
            bind.Mode = value.Mode or bind.Mode
            bind.Toggled = value.Toggled == true
        elseif value == true or value == false then
            bind.Toggled = value
        else
            bind.Key = keyFromString(value)
        end
        updateFlag()
    end
    function object:SetMode(mode) setMode(mode) end
    self.Keybinds[#self.Keybinds + 1] = {Name = data.Name, Object = object, State = bind, Flag = flag}
    self.SetFlags[flag] = function(value) object:Set(value) end
    updateFlag()
    return object
end

function SectionMethods:Slider(data)
    data = data or {}
    local flag = data.Flag or data.Name or "Slider"
    local min = data.Min or 0
    local max = data.Max or 100
    local value = data.Default or min
    local decimals = data.Decimals or data.Rounding or 0
    local holder = new("Frame", {Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1}, self.Body)
    new("TextLabel", {Size = UDim2.new(1, -54, 0, 16), BackgroundTransparency = 1, Text = data.Name or flag, TextColor3 = Library.Theme.Text, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left}, holder)
    local valueBox = new("TextBox", {Size = UDim2.fromOffset(48, 16), Position = UDim2.new(1, -48, 0, 0), BackgroundColor3 = Library.Theme.Input, BorderSizePixel = 0, Text = tostring(value), TextColor3 = Library.Theme.Text, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = false}, holder)
    round(valueBox, 3)
    stroke(valueBox, Library.Theme.Stroke, 0.15)
    local bar = new("Frame", {Size = UDim2.new(1, 0, 0, 5), Position = UDim2.fromOffset(0, 24), BackgroundColor3 = Library.Theme.Input, BorderSizePixel = 0}, holder)
    round(bar, 2)
    local fill = new("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Library.Theme.Accent2, BorderSizePixel = 0}, bar)
    round(fill, 2)
    local function roundValue(v)
        if decimals and decimals > 0 then
            local mult = 10 ^ decimals
            return math.floor(v * mult + 0.5) / mult
        end
        return math.floor(v + 0.5)
    end
    local function apply(v, silent)
        value = math.clamp(roundValue(tonumber(v) or value), min, max)
        local ratio = (value - min) / math.max(max - min, 1)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        valueBox.Text = tostring(value)
        Library.Flags[flag] = value
        if not silent then Library:SafeCall(data.Callback, value) end
    end
    local dragging = false
    local function fromX(x) apply(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)) end
    connect(bar.InputBegan, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true fromX(input.Position.X) end end)
    connect(UIS.InputChanged, function(input) if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then fromX(input.Position.X) end end)
    connect(UIS.InputEnded, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    connect(valueBox.FocusLost, function() apply(valueBox.Text) end)
    Library.SetFlags[flag] = function(v) apply(v, true) end
    apply(value, true)
    return {Set = function(_, v) apply(v, true) end, Get = function() return value end, Instance = holder}
end

function SectionMethods:Dropdown(data)
    data = data or {}
    local flag = data.Flag or data.Name or "Dropdown"
    local options = data.Options or data.Items or data.Values or {}
    local current = data.Default
    if type(current) == "number" then current = options[current] end
    if current == nil and #options > 0 then current = options[1] end
    local holder = new("Frame", {Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, ZIndex = 100}, self.Body)
    new("TextLabel", {Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1, Text = data.Name or flag, TextColor3 = Library.Theme.Dim, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left}, holder)
    local box = new("TextButton", {Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 14), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Text = "", AutoButtonColor = false}, holder)
    round(box, 4)
    stroke(box, Color3.fromRGB(55, 57, 65), 0.08)
    new("UIGradient", {Parent = box, Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(12, 13, 15), Color3.fromRGB(23, 25, 30))})
    local selected = new("TextLabel", {Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), BackgroundTransparency = 1, Text = type(current) == "table" and table.concat(current, ", ") or text(current), TextColor3 = Library.Theme.Text, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left}, box)
    local arrow = {Rotation = 0}
    local list = new("Frame", {Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Visible = false, ClipsDescendants = true, ZIndex = 9001}, self.Window.PopupLayer)
    round(list, 3)
    stroke(list, Library.Theme.Stroke, 0.1)
    new("UIGradient", {Parent = list, Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(12, 13, 15), Color3.fromRGB(23, 25, 30))})
    local scroll = new("ScrollingFrame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 9002}, list)
    new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, scroll)
    new("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4)}, scroll)
    local open = false
    local multi = data.Multi == true
    local currentSet = {}
    if multi and type(current) == "table" then for _, item in ipairs(current) do currentSet[item] = true end end
    local function valueText()
        if multi then
            local values = {}
            for _, option in ipairs(options) do if currentSet[option] then values[#values + 1] = option end end
            return #values > 0 and table.concat(values, ", ") or "None"
        end
        return text(current)
    end
    local function updateValue(silent)
        local output
        if multi then
            output = {}
            for _, option in ipairs(options) do if currentSet[option] then output[#output + 1] = option end end
            selected.Text = #output > 0 and table.concat(output, ", ") or "None"
        else
            output = current
            selected.Text = text(current)
        end
        Library.Flags[flag] = output
        if not silent then Library:SafeCall(data.Callback, output) end
    end
    local function place()
        local p = self.Window.PopupLayer.AbsolutePosition
        local b = box.AbsolutePosition
        list.Position = UDim2.fromOffset(b.X - p.X, b.Y - p.Y + box.AbsoluteSize.Y + 2)
    end
    local function close()
        open = false
        tween(list, {Size = UDim2.fromOffset(list.AbsoluteSize.X, 0)}, 0.12).Completed:Connect(function() if not open then list.Visible = false end end)
        arrow.Rotation = 0
    end
    local function openList()
        for _, frame in pairs(Library.OpenFrames) do pcall(frame) end
        Library.OpenFrames = {}
        open = true
        list.Visible = true
        place()
        list.Size = UDim2.fromOffset(box.AbsoluteSize.X, 0)
        tween(list, {Size = UDim2.fromOffset(box.AbsoluteSize.X, math.min(#options, 6) * 20 + 8)}, 0.16)
        arrow.Rotation = 180
        Library.OpenFrames[list] = close
    end
    for _, option in ipairs(options) do
        local row = new("TextButton", {Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 9003}, scroll)
        local label = new("TextLabel", {Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), BackgroundTransparency = 1, Text = text(option), TextColor3 = option == current and Library.Theme.Accent or Library.Theme.Dim, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9004}, row)
        connect(row.MouseButton1Click, function()
            if multi then currentSet[option] = not currentSet[option] else current = option close() end
            updateValue()
            label.TextColor3 = ((multi and currentSet[option]) or (not multi and option == current)) and Library.Theme.Accent or Library.Theme.Dim
        end)
    end
    connect(box.MouseButton1Click, function() if open then close() else openList() end end)
    connect(RunService.RenderStepped, function() if open and list.Visible then place() end end)
    connect(UIS.InputBegan, function(input)
        if not open or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        task.defer(function()
            if open and not inBounds(input.Position, list) and not inBounds(input.Position, box) then close() end
        end)
    end)
    Library.SetFlags[flag] = function(value)
        if multi and type(value) == "table" then
            currentSet = {}
            for _, item in ipairs(value) do currentSet[item] = true end
        else
            current = value
        end
        updateValue(true)
    end
    updateValue(true)
    return {Set = Library.SetFlags[flag], Get = function() return Library.Flags[flag] end, Refresh = function(_, newOptions) options = newOptions or options end, Instance = holder}
end

